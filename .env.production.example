# Production configuration for docker-compose.prod.yml.
# Copy to .env.production on the server (chmod 600). Never commit the real file.
# Generate secrets with the commands shown; every value marked CHANGE_ME must be replaced.

NODE_ENV=production
# Images: built locally (bulava/*) or pulled from the registry CI pushes to.
IMAGE_PREFIX=ghcr.io/<github-owner>/bulava
BULAVA_VERSION=latest

# ── Domains ──
# Host names Bulava answers to. The server's own Nginx gets a site for them
# (infrastructure/scripts/render-host-nginx.sh) and certbot issues the certificate.
BULAVA_DOMAIN=bulava.in
BULAVA_ADMIN_DOMAIN=admin.bulava.in
BULAVA_API_DOMAIN=api.bulava.in
# Also answer www.<BULAVA_DOMAIN> (redirected to the apex). Set false for a subdomain such as bulava.example.com.
BULAVA_WWW=true
# Public origins. The web image bakes WEB_ORIGIN in at build time, so rebuild after changing it.
WEB_ORIGIN=https://www.bulava.in
# The admin console (and any other first-party origin) that may call the API.
CORS_ORIGINS=https://www.bulava.in,https://admin.bulava.in

# ── Server integration ──
# bulava-nginx listens on 127.0.0.1:<port> only; the server's own Nginx proxies to it.
# Pick a port nothing else uses (check with: sudo ss -tlpn).
BULAVA_HTTP_PORT=18090
# Video and card rendering (Remotion + Chrome) needs at least 2 spare CPUs and 3 GB of memory.
# Leave empty on a small or shared server; set to "video" to run the video worker.
COMPOSE_PROFILES=

# ── Resources (Docker limits per container) ──
# Defaults suit a small shared server (1 CPU). A CPU limit above the server's CPU count
# stops the container from starting. On a dedicated 4 CPU / 8 GB server, for example:
# API_CPUS=2 WEB_CPUS=2 MEDIA_WORKER_CPUS=2 VIDEO_WORKER_CPUS=3 API_MEMORY=1g WEB_MEMORY=1g VIDEO_WORKER_MEMORY=4g
API_CPUS=1
API_MEMORY=768m
WEB_CPUS=1
WEB_MEMORY=512m
ADMIN_CPUS=0.5
ADMIN_MEMORY=384m
WORKER_CPUS=0.5
WORKER_MEMORY=384m
MEDIA_WORKER_CPUS=1
MEDIA_WORKER_MEMORY=768m
VIDEO_WORKER_CPUS=1
VIDEO_WORKER_MEMORY=3g

# ── PostgreSQL (internal network only) ──
POSTGRES_USER=bulava
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bulava

# ── Redis (internal network only; BullMQ queues) ──
REDIS_PASSWORD=CHANGE_ME

# ── Auth ──
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 32 bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=CHANGE_ME
COOKIE_SECURE=true

# ── Owner account (seeded by the migrate job on every deploy; idempotent) ──
# Becomes the Super Admin while there is none (only one can exist); after the role is handed over
# in Staff & roles, deploys never take it back. Use a strong, unique password and change it after
# the first sign-in.
ADMIN_EMAIL=admin@bulava.in
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Platform Admin
ADMIN_RESET_PASSWORD=false
# Staff (every platform role except USER) must pass two-step sign-in (authenticator app) before any
# admin route. Defaults to true in production and cannot be turned off there.
# Lost device: the Super Admin resets it in Staff & roles, or pnpm admin:reset-mfa <email>.
STAFF_MFA_REQUIRED=true

# ── Integrations ──
# Email, payments, WhatsApp, Google Maps and custom domains can be managed by the Super Admin in the
# admin console (Website > Integrations). These variables are used until a group is first saved
# there; the first save copies them (secrets encrypted) and the console's values win from then on.

# ── Object storage: Cloudflare R2 ──
# S3 API endpoint used by the API and workers.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Endpoint used in signed URLs handed to browsers (same as R2_ENDPOINT unless you front it).
R2_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY=CHANGE_ME
R2_SECRET_KEY=CHANGE_ME
R2_BUCKET=bulava-prod
STORAGE_AUTO_CREATE_BUCKET=false
# Origin of signed storage URLs, allowed by the web/admin Content-Security-Policy (build-time).
STORAGE_PUBLIC_ORIGIN=https://<account-id>.r2.cloudflarestorage.com

# ── Workers ── (on a 1 CPU server keep media and video work to one job at a time)
WORKER_CONCURRENCY=10
MEDIA_WORKER_CONCURRENCY=1
VIDEO_WORKER_CONCURRENCY=1
VIDEO_RENDER_THREADS=1

# ── Event lifecycle (general worker, daily) ──
# ACTIVE → COMPLETED this many days after the last function; COMPLETED → ARCHIVED later.
EVENT_COMPLETE_AFTER_DAYS=2
EVENT_ARCHIVE_AFTER_DAYS=180
# Soft-deleted events (and their photos/videos) are purged permanently after this many days.
EVENT_RETENTION_DAYS=30

# ── Email (transactional SMTP, e.g. Amazon SES, Postmark, Zoho) ──
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM="Bulava <invites@bulava.in>"

# ── Payments: Razorpay ──
RAZORPAY_KEY=CHANGE_ME
RAZORPAY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# ── WhatsApp Business (Meta Cloud API; optional) ──
# Templates approved in WhatsApp Manager; body variables {{1}} guest name, {{2}} event, {{3}} link.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_INVITATION_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ── Google Maps on invitations (Maps Embed API browser key; optional) ──
# Restrict it to your domains (and customers' custom domains) in Google Cloud. Maps stay off until
# the Super Admin switches them on in Integrations > Google Maps.
GOOGLE_MAPS_KEY=

# ── Observability ──
SENTRY_DSN=
# Bearer token Prometheus uses to scrape the API's /metrics on the internal network.
METRICS_TOKEN=CHANGE_ME
LOG_LEVEL=info

# ── Analytics (optional; baked into the web build) ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_GA4_ID=
POSTHOG_KEY=
POSTHOG_HOST=

# ── Backups (infrastructure/scripts/backup-postgres.sh) ──
# A separate R2 bucket (or any S3-compatible store) with versioning/retention enabled.
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=bulava-backups
BACKUP_S3_ACCESS_KEY=CHANGE_ME
BACKUP_S3_SECRET_KEY=CHANGE_ME
BACKUP_RETENTION_DAYS=30
# age public key: backups are encrypted before they leave the server.
BACKUP_AGE_RECIPIENT=age1CHANGE_ME

# ── "Continue with Google" ── redirect URI: https://bulava.in/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Custom domains (Cloudflare for SaaS, fallback origin domains.bulava.in) ──
CUSTOM_DOMAIN_TARGET=domains.bulava.in
CUSTOM_DOMAIN_ADDRESSES=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
