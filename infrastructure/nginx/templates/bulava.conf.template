# Bulava's sites, behind the host's Nginx. The host terminates TLS for these
# hostnames and forwards them here over plain HTTP (infrastructure/nginx/host/).
# The nginx image renders this file into /etc/nginx/conf.d/bulava.conf at start-up,
# replacing only BULAVA_* variables from .env.production (NGINX_ENVSUBST_FILTER),
# so Nginx's own $variables are left alone.

# ───── Any other host: customers' own event domains, and the Docker health probe ─────
# Customer domains only arrive here once the host forwards them (docs/custom-domains.md).
# The web app serves only hosts that are live event domains and answers 404 otherwise.
server {
  listen 80 default_server;
  server_name _;
  include /etc/nginx/snippets/security-headers.conf;
  limit_conn conn_per_ip 50;

  # Docker's health check only. `return` runs before allow/deny would, so the address
  # is checked here; through the proxy it is the visitor's (see real IPs in nginx.conf).
  location = /nginx-health {
    access_log off;
    if ($remote_addr != "127.0.0.1") {
      return 404;
    }
    return 200 "ok\n";
  }

  # Staff and payment endpoints never live on customer domains.
  location /api/v1/admin/ {
    return 404;
  }
  location /api/v1/payments/ {
    return 404;
  }

  location /api/v1/ {
    limit_req zone=api_per_ip burst=40 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://bulava_api;
  }

  location /_next/static/ {
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://bulava_web;
  }

  location / {
    limit_req zone=web_per_ip burst=60 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://bulava_web;
  }
}

# ───── www → apex ─────
server {
  listen 80;
  server_name www.${BULAVA_DOMAIN};
  include /etc/nginx/snippets/security-headers.conf;
  return 301 https://${BULAVA_DOMAIN}$request_uri;
}

# ───── The customer site (Next.js) ─────
server {
  listen 80;
  server_name ${BULAVA_DOMAIN};
  include /etc/nginx/snippets/security-headers.conf;
  limit_conn conn_per_ip 50;

  # Same-origin API calls go straight to the API (skipping the Next.js proxy hop).
  # Session cookies stay first-party on the main domain.
  location /api/v1/ {
    limit_req zone=api_per_ip burst=40 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://bulava_api;
  }

  # Hashed build assets: Next.js already marks them immutable; no rate limit.
  location /_next/static/ {
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://bulava_web;
  }

  location / {
    limit_req zone=web_per_ip burst=60 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://bulava_web;
  }
}

# ───── API host: API clients and payment webhooks ─────
server {
  listen 80;
  server_name ${BULAVA_API_DOMAIN};
  include /etc/nginx/snippets/security-headers.conf;
  limit_conn conn_per_ip 50;

  # Prometheus metrics are scraped on the internal network only.
  location = /metrics {
    return 404;
  }

  # Razorpay webhooks: signature-verified by the API over the raw body.
  location /api/v1/payments/razorpay/webhook {
    client_max_body_size 1m;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://bulava_api;
  }

  # WhatsApp webhooks: signature-verified by the API over the raw body (POST) & GET handshake.
  location /api/v1/whatsapp/webhook {
    client_max_body_size 1m;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://bulava_api;
  }

  # GetGabs chats webhook: a secret token in the query string, checked by the API (and kept out of the logs).
  location = /api/v1/whatsapp/getgabs {
    client_max_body_size 1m;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://bulava_api;
  }

  location / {
    limit_req zone=api_per_ip burst=40 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    # Guest and event exports can take longer than a normal request.
    proxy_read_timeout 120s;
    proxy_pass http://bulava_api;
  }
}

# ───── Admin host: staff console ─────
server {
  listen 80;
  server_name ${BULAVA_ADMIN_DOMAIN};
  include /etc/nginx/snippets/security-headers.conf;
  limit_conn conn_per_ip 30;

  # Optional: restrict the console to office/VPN addresses (real client IPs, see nginx.conf).
  # allow 203.0.113.0/24;
  # deny all;

  location /api/v1/ {
    limit_req zone=api_per_ip burst=40 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://bulava_api;
  }

  location / {
    limit_req zone=web_per_ip burst=60 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://bulava_admin;
  }
}
