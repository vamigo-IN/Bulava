  sizeBytes       BigInt
  watermarked     Boolean  @default(false)
  createdAt       DateTime @default(now())

  videoJob VideoJob @relation(fields: [videoJobId], references: [id], onDelete: Cascade)

  @@map("generated_videos")
}

// ───────────────────────────── Media ─────────────────────────────

enum GalleryVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
  FUNCTION_RESTRICTED
}

enum ModerationMode {
  AUTO_APPROVE
  MANUAL_APPROVAL
  AI_ASSISTED
}

/// An event's photo album. Each event has one main album (isMain; a partial
/// unique index allows only one) with a single upload link, gallery and live
/// wall, organised into sub-albums (MediaAlbum). The hidden Design photos room
/// is the only other room.
model MediaRoom {
  id                  String            @id @default(uuid(7)) @db.Uuid
  eventId             String            @db.Uuid
  functionId          String?           @db.Uuid
  name                String
  slug                String
  isMain              Boolean           @default(false)
  galleryVisibility   GalleryVisibility @default(INVITE_ONLY)
  moderationMode      ModerationMode    @default(AUTO_APPROVE)
  uploadsEnabled      Boolean           @default(true)
  downloadPolicy      Json              @default("{\"guestsCanDownload\":false,\"originalQuality\":false}")
  liveWallEnabled     Boolean           @default(false)
  /// Secret link for the live photo wall (/wall/<token>): SHA-256 for lookup,
  /// AES-GCM ciphertext so the host can copy it again. Rotating replaces both.
  wallTokenHash       String?           @unique
  wallTokenCiphertext String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  function    EventFunction?    @relation(fields: [functionId], references: [id], onDelete: SetNull)
  items       MediaItem[]
  albums      MediaAlbum[]
  permissions MediaPermission[]

  @@unique([eventId, slug])
  @@index([eventId])
  @@map("media_rooms")
}

enum MediaAlbumKind {
  /// Photos not tied to a function. One per main album.
  GENERAL
  /// One per function, kept in step with the event's functions.
  FUNCTION
  /// Added by the host (pre-wedding shoot, family portraits...).
  CUSTOM
}

/// A sub-album (folder) of an event's main album. Guests and photographers
/// pick one when they upload; the host decides which ones the guest gallery
/// and the live wall show. Partial unique indexes allow one GENERAL album per
/// room and one album per function.
model MediaAlbum {
  id            String         @id @default(uuid(7)) @db.Uuid
  roomId        String         @db.Uuid
  eventId       String         @db.Uuid
  kind          MediaAlbumKind
  /// FUNCTION albums keep their function's name in step.
  name          String
  functionId    String?        @db.Uuid
  showInGallery Boolean        @default(true)
  showOnWall    Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  room     MediaRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  function EventFunction? @relation(fields: [functionId], references: [id], onDelete: SetNull)
  items    MediaItem[]

  @@index([eventId])
  @@index([roomId, sortOrder])
  @@map("media_albums")
}

enum MediaItemStatus {
  UPLOADING
  PROCESSING
  PENDING_MODERATION
  APPROVED
  REJECTED
  DELETED
}

enum MediaPrivacy {
  PUBLIC
  EVENT_ONLY
  GROUP_ONLY
  PRIVATE
}

model MediaItem {
  id              String          @id @default(uuid(7)) @db.Uuid
  roomId          String          @db.Uuid
  /// The sub-album; null only for design photos.
  albumId         String?         @db.Uuid
  eventId         String          @db.Uuid
  uploaderGuestId String?         @db.Uuid
  uploaderUserId  String?         @db.Uuid
  uploaderName    String?
  kind            String
  originalKey     String          @unique
  optimizedKey    String?
  thumbnailKey    String?
  mimeType        String
  sizeBytes       BigInt
  width           Int?
  height          Int?
  status          MediaItemStatus @default(UPLOADING)
  privacy         MediaPrivacy    @default(EVENT_ONLY)
  moderationNotes String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  room  MediaRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  album MediaAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@index([roomId, status, createdAt])
  @@index([albumId, status, createdAt])
  @@index([eventId])
  @@map("media_items")
}

/// Per-room permission for a principal (ROLE, GROUP or GUEST).
model MediaPermission {
  id            String  @id @default(uuid(7)) @db.Uuid
  roomId        String  @db.Uuid
  principalType String
  principalId   String
  canUpload     Boolean @default(false)
  canView       Boolean @default(false)
  canDownload   Boolean @default(false)
  canDelete     Boolean @default(false)
  canModerate   Boolean @default(false)

  room MediaRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, principalType, principalId])
  @@map("media_permissions")
}

enum QRType {
  EVENT
  FUNCTION
  PHOTO_UPLOAD
  GALLERY
  CHECK_IN
  INVITATION
}

model QRCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  eventId   String    @db.Uuid
  type      QRType
  targetId  String?   @db.Uuid
  code      String    @unique
  active    Boolean   @default(true)
  scanCount Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, type])
  @@map("qr_codes")
}

// ───────────────────────────── Commerce ─────────────────────────────

model PricingPlan {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  name        String
  description String?
  priceMinor  Int
  currency    String   @default("INR")
  interval    String   @default("ONE_TIME")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  features PlanFeature[]
  orders   Order[]

  @@map("pricing_plans")
}

/// Feature limit per plan, e.g. featureKey="media.photos.max" limit=500.
model PlanFeature {
  id         String  @id @default(uuid(7)) @db.Uuid
  planId     String  @db.Uuid
  featureKey String
  enabled    Boolean @default(true)
  limit      Int?

  plan PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("plan_features")
}

model Coupon {
  id             String    @id @default(uuid(7)) @db.Uuid
  code           String    @unique
  percentOff     Int?
  amountOffMinor Int?
  maxRedemptions Int?
  redemptions    Int       @default(0)
  validFrom      DateTime?
  validUntil     DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  orders Order[]

  @@map("coupons")
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model Order {
  id              String      @id @default(uuid(7)) @db.Uuid
  userId          String      @db.Uuid
  eventId         String?     @db.Uuid
  planId          String      @db.Uuid
  couponId        String?     @db.Uuid
  amountMinor     Int
  currency        String      @default("INR")
  status          OrderStatus @default(CREATED)
  providerOrderId String?     @unique
  /// PURCHASE (checkout) or ADMIN_GRANT (a complimentary upgrade by the Super Admin).
  kind            String      @default("PURCHASE")
  /// Why a grant was made (required for ADMIN_GRANT).
  note            String?
  grantedById     String?     @db.Uuid
  /// When the buyer ticked the Terms and the Refund Policy for this purchase (also kept as a Consent).
  termsAcceptedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  plan     PricingPlan @relation(fields: [planId], references: [id])
  coupon   Coupon?     @relation(fields: [couponId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([status, createdAt])
  @@map("orders")
}

model Payment {
  id                String    @id @default(uuid(7)) @db.Uuid
  orderId           String    @db.Uuid
  provider          String    @default("RAZORPAY")
  providerPaymentId String    @unique
  status            String
  amountMinor       Int
  rawWebhook        Json?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Entitlement {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  eventId    String?   @db.Uuid
  featureKey String
  /**
   * false switches a feature off (e.g. branding.watermark removed).
   */
  enabled    Boolean   @default(true)
  limit      Int?
  used       Int       @default(0)
  sourceType String
  sourceId   String?
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, featureKey])
  @@index([eventId, featureKey])
  @@map("entitlements")
}

// ───────────────────────────── Platform ─────────────────────────────

/// Platform settings managed by the Super Admin (one row per group: site, seo,
/// tracking, code, payments, email, whatsapp, maps, domains, storage). `secrets`
/// holds AES-GCM ciphertexts (TOKEN_ENCRYPTION_KEY) that are never sent to a browser.
model PlatformSetting {
  key         String   @id
  value       Json     @default("{}")
  secrets     Json     @default("{}")
  /// Result of the last connection check: { ok, steps, checkedAt }.
  lastCheck   Json?
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("platform_settings")
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  eventId   String?   @db.Uuid
  userId    String?   @db.Uuid
  guestId   String?   @db.Uuid
  type      String
  channel   String
  payload   Json
  status    String    @default("QUEUED")
  error     String?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([eventId])
  @@map("notifications")
}

model AnalyticsEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String
  eventId    String?  @db.Uuid
  userId     String?  @db.Uuid
  guestId    String?  @db.Uuid
  properties Json     @default("{}")
  occurredAt DateTime @default(now())

  @@index([name, occurredAt])
  @@index([eventId, name])
  @@map("analytics_events")
}

/// who / did what / to what / when / from where / result
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorType  String
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String?
  eventId    String?  @db.Uuid
  result     String   @default("SUCCESS")
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// Customer testimonials shown on the marketing site. Admin-managed; only
/// real, consented quotes may be published.
model Testimonial {
  id         String   @id @default(uuid(7)) @db.Uuid
  quote      String
  authorName String
  location   String?
  eventLabel String?
  rating     Int      @default(5)
  consentAt  DateTime
  published  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, sortOrder])
  @@map("testimonials")
}

enum SitePageLayout {
  /// One reading column with an "On this page" index (policies).
  DOCUMENT
  /// Each section a card (About).
  CARDS
  /// The contact form, contact actions and the sections beside them.
  CONTACT
}

enum SitePageStatus {
  DRAFT
  PUBLISHED
}

enum SitePageFooterGroup {
  COMPANY
  LEGAL
}

/// Site pages at /<slug> (About, Contact, the policies and pages staff add),
/// edited in the admin console. Built-in pages are seeded once and are never
/// overwritten by later seeds; they can be edited but not deleted, unpublished
/// or moved, because the footer, the checkout and the payment gateway link to them.
model SitePage {
  id          String               @id @default(uuid(7)) @db.Uuid
  slug        String               @unique
  title       String
  description String
  layout      SitePageLayout       @default(DOCUMENT)
  status      SitePageStatus       @default(DRAFT)
  system      Boolean              @default(false)
  footerGroup SitePageFooterGroup?
  sortOrder   Int                  @default(0)
  /// [{ heading, body }], validated by SitePageInputSchema (@bulava/validation).
  sections    Json                 @default("[]")
  publishedAt DateTime?
  updatedById String?              @db.Uuid
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, footerGroup, sortOrder])
  @@map("site_pages")
}

enum ContactTopic {
  GENERAL
  EVENT_HELP
  BILLING
  PARTNERSHIP
  PRIVACY
  FEEDBACK
}

enum ContactStatus {
  NEW
  OPEN
  RESOLVED
  SPAM
}

/// A message sent through the public contact form, handled in the console's
/// inbox. Nothing links it to an account: the sender is whoever they say they are.
model ContactMessage {
  id          String         @id @default(uuid(7)) @db.Uuid
  /// Short reference shown to the sender and quoted in replies (e.g. BLV-7KQ2M9).
  reference   String         @unique
  name        String
  email       String         @db.Citext
  phone       String?
  topic       ContactTopic
  message     String
  status      ContactStatus  @default(NEW)
  /// Staff only; never sent to the sender.
  note        String?
  handledById String?        @db.Uuid
  repliedAt   DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  replies     ContactReply[]

  @@index([status, createdAt])
  @@index([email])
  @@map("contact_messages")
}

/// A reply emailed to the sender from the console.
model ContactReply {
  id        String         @id @default(uuid(7)) @db.Uuid
  messageId String         @db.Uuid
  message   ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  body      String
  sentById  String?        @db.Uuid
  createdAt DateTime       @default(now())

  @@index([messageId, createdAt])
  @@map("contact_replies")
}

// ───────────────────────── Public registration (spec §89) ─────────────────────────

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  REJECTED
  CANCELLED
}

/// Self-registration for PUBLIC and PRIVATE_LINK events. No row = registration off.
model EventRegistrationSettings {
  eventId          String    @id @db.Uuid
  enabled          Boolean   @default(false)
  /// Extra form fields, validated by RegistrationFieldsSchema (@bulava/validation).
  fields           Json      @default("[]")
  /// Confirmed places; null = no cap beyond the plan's guest limit.
  maxRegistrations Int?
  approvalRequired Boolean   @default(false)
  waitlistEnabled  Boolean   @default(false)
  closesAt         DateTime?
  /// Registered guests join this group so hosts can target functions at them.
  groupId          String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_registration_settings")
}

/// One registration per guest record. The guest is created when someone registers.
model Registration {
  id          String             @id @default(uuid(7)) @db.Uuid
  eventId     String             @db.Uuid
  guestId     String             @unique @db.Uuid
  status      RegistrationStatus
  answers     Json               @default("{}")
  decidedById String?            @db.Uuid
  decidedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([eventId, status, createdAt])
  @@map("registrations")
}

// ───────────────────────────── Guest logistics (spec §52–53) ─────────────────────────────

/// A guest's table at one function. Seating is not access: a seat never lets
/// anyone into a function, and a guest only sees seats for functions they can see.
model SeatAssignment {
  functionId String   @db.Uuid
  guestId    String   @db.Uuid
  eventId    String   @db.Uuid
  tableLabel String
  seatLabel  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  function EventFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)
  guest    Guest         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([functionId, guestId])
  @@index([eventId, functionId])
  @@index([guestId])
  @@map("seat_assignments")
}

/// Where a guest stays during the event. Shown only to that guest.
model GuestStay {
  id         String    @id @default(uuid(7)) @db.Uuid
  eventId    String    @db.Uuid
  guestId    String    @unique @db.Uuid
  hotelName  String
  address    String?
  mapUrl     String?
  roomNumber String?
  roomType   String?
  checkInAt  DateTime?
  checkOutAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([eventId, hotelName])
  @@map("guest_stays")
}

enum TravelDirection {
  ARRIVAL
  DEPARTURE
}

enum TravelMode {
  FLIGHT
  TRAIN
  ROAD
  BUS
  OTHER
}

/// A guest's arrival or departure, entered by the host or by the guest.
/// `pickupRequested` means a pickup on arrival or a drop on departure.
model GuestTravel {
  id              String          @id @default(uuid(7)) @db.Uuid
  eventId         String          @db.Uuid
  guestId         String          @db.Uuid
  direction       TravelDirection
  mode            TravelMode
  /// Airline, train or operator, e.g. "IndiGo" or "Shatabdi Express".
  carrier         String?
  /// Flight or train number, or a vehicle registration.
  reference       String?
  /// Arrival time for ARRIVAL, departure time for DEPARTURE.
  at              DateTime
  /// Airport, station or city, e.g. "Jaipur Airport (JAI)".
  place           String?
  travellers      Int             @default(1)
  pickupRequested Boolean         @default(false)
  /// Host's arrangement shown to the guest, e.g. "Driver Ramesh, white Innova".
  pickupNote      String?
  /// Last edited from the invitation page (not by the host team).
  enteredByGuest  Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([guestId, direction])
  @@index([eventId, direction, at])
  @@map("guest_travel")
}

/// Automatic reminders for one event (spec §49). The worker sends them; the
/// sent markers make every run idempotent across worker replicas.
model EventReminderSettings {
  eventId                String    @id @db.Uuid
  /// Remind invited guests who have not replied, at this moment (null = off).
  rsvpReminderAt         DateTime?
  rsvpReminderSentAt     DateTime?
  rsvpReminderRecipients Int?
  /// Remind guests who have not declined this many hours before each function (null = off).
  functionReminderHours  Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([rsvpReminderAt])
  @@map("event_reminder_settings")
}

enum DomainStatus {
  PENDING
  ACTIVE
  FAILED
}

/// A host's own domain for their event (a plan feature). Ownership is proven
/// with a DNS TXT record; traffic reaches Bulava through a CNAME (or A records)
/// and TLS comes from Cloudflare for SaaS or the operator's own setup.
model EventDomain {
  id                String       @id @default(uuid(7)) @db.Uuid
  eventId           String       @unique @db.Uuid
  /// Lower-case, punycode, e.g. "amanweddsriya.com". Several events may claim a
  /// hostname; only one claim can be verified at a time (partial unique index).
  hostname          String
  status            DomainStatus @default(PENDING)
  verificationToken String
  verifiedAt        DateTime?
  /// Custom hostname id at the TLS provider (Cloudflare), when one is used.
  providerId        String?
  sslStatus         String?
  /// Why the last check did not activate the domain (TXT_MISSING, ROUTING_MISSING, SSL_PENDING, PROVIDER_ERROR, EXPIRED, TAKEN).
  lastError         String?
  /// Consecutive failed checks of an active domain; it is switched off after a few.
  failedChecks      Int          @default(0)
  lastCheckedAt     DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([hostname])
  @@index([status, lastCheckedAt])
  @@map("event_domains")
}
