enum VideoJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model VideoJob {
  id                String         @id @default(uuid(7)) @db.Uuid
  eventId           String         @db.Uuid
  templateVersionId String         @db.Uuid
  status            VideoJobStatus @default(QUEUED)
