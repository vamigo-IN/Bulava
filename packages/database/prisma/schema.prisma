// Bulava data model.
// Conventions:
//  - All primary keys are UUIDv7 (time-ordered, non-sequential, safe to expose).
//  - Every tenant-owned row carries eventId (directly or via its parent) so that
//    every query can be scoped to an event the actor is authorized for.
//  - EVENT, FUNCTION, AUDIENCE (groups/assignments) and ACCESS POLICY are
//    separate models. Never collapse them into one permission field.
//  - Timestamps are stored in UTC; rendering uses Event.timezone.
//  - Soft delete via deletedAt where user data is involved.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Generated inside this package so it ships with it (pnpm deploy / Docker).
  output          = "../generated/client"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// ───────────────────────────── Identity ─────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
  /// The owner deleted the account; it can be restored by signing in until deletionScheduledAt.
  PENDING_DELETION
}

/// Staff roles. Exactly one SUPER_ADMIN may exist (a partial unique index enforces it);
/// the role changes hands only through the transfer endpoint.
enum PlatformRole {
  USER
  SUPPORT
  PLATFORM_ADMIN
  SUPER_ADMIN
  CONTENT_MANAGER
  FINANCE_MANAGER
}

model User {
  id                   String       @id @default(uuid(7)) @db.Uuid
  email                String?      @unique @db.Citext
  phone                String?      @unique
  name                 String
  passwordHash         String?
  /// Google account id ("sub") for "Continue with Google"; null when not linked.
  googleSub            String?      @unique
  emailVerifiedAt      DateTime?
  phoneVerifiedAt      DateTime?
  locale               String       @default("en")
  status               UserStatus   @default(ACTIVE)
  platformRole         PlatformRole @default(USER)
  /// Two-step sign-in (TOTP). The shared secret is AES-GCM encrypted with TOKEN_ENCRYPTION_KEY.
  totpSecretCiphertext String?
  totpEnabledAt        DateTime?
  /// Last accepted time step, so a code cannot be used twice.
  totpLastStep         Int?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?
  /// When the owner asked for the account to be deleted (also the moment their events went offline).
  deletionRequestedAt  DateTime?
  /// After this, the worker erases the account for good; until then signing in can restore it.
  deletionScheduledAt  DateTime?
  /// Made from a WhatsApp number alone (the template page's quick start). Cleared once the
  /// number is verified with a code, or an email and password or Google are added.
  provisional          Boolean      @default(false)
  /// Agreed to updates on WhatsApp (an optional consent, also kept as a Consent row).
  whatsappOptInAt      DateTime?

  sessions         Session[]
  ownedEvents      Event[]              @relation("EventOwner")
  eventMemberships EventMember[]
  orgMemberships   OrganizationMember[]
  auditLogs        AuditLog[]
  orders           Order[]
  entitlements     Entitlement[]
  consents         Consent[]
  recoveryCodes    MfaRecoveryCode[]
  memberInvites    EventMemberInvite[]  @relation("MemberInvitesSent")

  @@index([status, deletionScheduledAt])
  @@map("users")
}

/// Refresh-token session. Only a SHA-256 hash of the refresh token is stored.
/// Tokens rotate on every refresh; reuse of a rotated token revokes the family.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  familyId   String    @db.Uuid
  expiresAt  DateTime
  revokedAt  DateTime?
  rotatedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  /// True when the sign-in that started this session family passed two-step verification.
  mfa        Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

/// One-time recovery codes for two-step sign-in. Only SHA-256 hashes are stored.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_recovery_codes")
}

/// OTP challenges for phone/email verification and guest identity checks.
model OtpChallenge {
  id          String    @id @default(uuid(7)) @db.Uuid
  purpose     String
  target      String
  codeHash    String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([target, purpose])
  @@map("otp_challenges")
}

model Consent {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String?  @db.Uuid
  guestId   String?  @db.Uuid
  kind      String
  granted   Boolean
  version   String
  source    String?
  createdAt DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guest Guest? @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([guestId])
  @@map("consents")
}

// ───────────────────── Organizations (planner / agency) ─────────────────────

enum OrganizationRole {
  OWNER
  ADMIN
  STAFF
}

model Organization {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String    @unique
  kind      String    @default("PERSONAL")
  settings  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members OrganizationMember[]
  events  Event[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// ───────────────────────────── Events ─────────────────────────────

/// Event categories are data, not an enum, so new categories need no migration.
model EventType {
  key              String   @id
  name             String
  description      String?
  /// Suggested functions, e.g. [{"name":"Haldi","slug":"haldi"}]
  defaultFunctions Json     @default("[]")
  /// Suggested guest groups, e.g. [{"name":"Bride Family","slug":"bride-family"}]
  defaultGroups    Json     @default("[]")
  /// Key of the details schema in @bulava/validation (eventDetailsSchemas).
  detailsSchemaKey String?
  enabled          Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  events Event[]

  @@map("event_types")
}

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
  CANCELLED
}

/// Discoverability only. Who can open content is decided by AccessPolicy.
enum Visibility {
  LISTED
  UNLISTED
}

model Event {
  id                 String      @id @default(uuid(7)) @db.Uuid
  ownerId            String      @db.Uuid
  organizationId     String?     @db.Uuid
  typeKey            String
  title              String
  slug               String      @unique
  description        String?
  coverImageAssetId  String?     @db.Uuid
  language           String      @default("en")
  timezone           String      @default("Asia/Kolkata")
  status             EventStatus @default(DRAFT)
  visibility         Visibility  @default(UNLISTED)
  accessPolicyId     String      @unique @db.Uuid
  startDate          DateTime?
  endDate            DateTime?
  /// Category-specific details, e.g. wedding couple names. Validated per EventType.
  details            Json        @default("{}")
  settings           Json        @default("{}")
  /// Guests may add their own arrival/departure details from their invitation.
  collectGuestTravel Boolean     @default(false)
  /// The host's shareable preview link (/preview/<token>): the invitation with a watermark,
  /// before the event is published and whatever its access mode. Unguessable, replaceable.
  previewToken       String      @unique
  /// How the event was started: "quick_start" (the template page) or null (the dashboard).
  source             String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  owner        User          @relation("EventOwner", fields: [ownerId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  type         EventType     @relation(fields: [typeKey], references: [key])
  accessPolicy AccessPolicy  @relation("EventAccessPolicy", fields: [accessPolicyId], references: [id])

  members              EventMember[]
  functions            EventFunction[]
  venues               Venue[]
  guests               Guest[]
  groups               GuestGroup[]
  invitations          Invitation[]
  invitationTokens     InvitationToken[]
  rsvps                RSVP[]
  rsvpQuestions        RSVPQuestion[]
  announcements        Announcement[]
  templateSelections   EventTemplateSelection[]
  videoJobs            VideoJob[]
  mediaRooms           MediaRoom[]
  qrCodes              QRCode[]
  checkIns             CheckIn[]
  functionGuests       FunctionGuest[]
  groupMembers         GuestGroupMember[]
  registrationSettings EventRegistrationSettings?
  registrations        Registration[]
  seatAssignments      SeatAssignment[]
  guestStays           GuestStay[]
  guestTravel          GuestTravel[]
  reminderSettings     EventReminderSettings?
  domain               EventDomain?
  memberInvites        EventMemberInvite[]

  @@index([ownerId, deletedAt])
  @@index([organizationId])
  @@index([visibility, status])
  @@map("events")
}

enum EventRole {
  OWNER
  ADMIN
  CO_HOST
  FUNCTION_MANAGER
  GUEST_MANAGER
  MEDIA_MANAGER
  PHOTOGRAPHER
}

model EventMember {
  id          String    @id @default(uuid(7)) @db.Uuid
  eventId     String    @db.Uuid
  userId      String    @db.Uuid
  role        EventRole
  /// Optional restriction for FUNCTION_MANAGER; empty = all functions.
  functionIds String[]  @default([]) @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_members")
}

enum MemberInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  /// Too many wrong codes; the host sends a new invitation.
  LOCKED
}

/// A team invitation for an email with no Bulava account yet: an emailed link
/// plus a 6-digit code. The code has no time limit; it works once, and the
/// invitation locks after too many wrong tries. At most one PENDING invitation
/// per event and email (partial unique index in the migration).
model EventMemberInvite {
  id           String             @id @default(uuid(7)) @db.Uuid
  eventId      String             @db.Uuid
  /// Lower-cased.
  email        String
  role         EventRole
  /// Optional restriction for FUNCTION_MANAGER, as on EventMember.
  functionIds  String[]           @default([]) @db.Uuid
  /// SHA-256 of the link token.
  tokenHash    String             @unique
  /// HMAC of the 6-digit code (never stored in plain text).
  codeHash     String
  attempts     Int                @default(0)
  status       MemberInviteStatus @default(PENDING)
  invitedById  String?            @db.Uuid
  acceptedById String?            @db.Uuid
  acceptedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("MemberInvitesSent", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([email, status])
  @@map("event_member_invites")
}

enum AccessMode {
  PUBLIC
  PRIVATE_LINK
  INVITE_ONLY
  GROUP_RESTRICTED
  SECRET_TOKEN
}

/// How access is verified. Every Event owns one (required). An EventFunction
/// may own one as an override; null means "inherit the event policy".
model AccessPolicy {
  id                  String     @id @default(uuid(7)) @db.Uuid
  mode                AccessMode @default(INVITE_ONLY)
  /// scrypt hash of an optional PIN (PRIVATE_LINK).
  pinHash             String?
  requireOtp          Boolean    @default(false)
  /// SECRET_TOKEN: the event's shared secret link (?k=<token>). SHA-256 for
  /// lookup, AES-GCM ciphertext so the host can copy it again; "New link"
  /// replaces both and the old link stops working.
  linkTokenHash       String?    @unique
  linkTokenCiphertext String?
  /// The secret link stops working at this time.
  linkExpiresAt       DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  event    Event?         @relation("EventAccessPolicy")
  function EventFunction? @relation("FunctionAccessPolicy")

  @@map("access_policies")
}

model Venue {
  id         String   @id @default(uuid(7)) @db.Uuid
  eventId    String   @db.Uuid
  name       String
  address    String?
  city       String?
  state      String?
  country    String   @default("IN")
  postalCode String?
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  mapUrl     String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  functions EventFunction[]

  @@index([eventId])
  @@map("venues")
}

enum FunctionStatus {
  DRAFT
  SCHEDULED
  POSTPONED
  CANCELLED
  COMPLETED
}

model EventFunction {
  id              String         @id @default(uuid(7)) @db.Uuid
  eventId         String         @db.Uuid
  name            String
  slug            String
  description     String?
  startsAt        DateTime?
  endsAt          DateTime?
  venueId         String?        @db.Uuid
  visibility      Visibility     @default(LISTED)
  accessPolicyId  String?        @unique @db.Uuid
  themeId         String?        @db.Uuid
  status          FunctionStatus @default(SCHEDULED)
  sortOrder       Int            @default(0)
  settings        Json           @default("{}")
  /// The start time the last reminder was sent for; a new time makes the function due again.
  reminderSentFor DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  event          Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue          Venue?                  @relation(fields: [venueId], references: [id], onDelete: SetNull)
  accessPolicy   AccessPolicy?           @relation("FunctionAccessPolicy", fields: [accessPolicyId], references: [id])
  theme          Theme?                  @relation(fields: [themeId], references: [id], onDelete: SetNull)
  audienceGroups FunctionAudienceGroup[]
  guests         FunctionGuest[]
  invitations    Invitation[]
  rsvps          RSVP[]
  rsvpQuestions  RSVPQuestion[]
  mediaRooms     MediaRoom[]
  mediaAlbums    MediaAlbum[]
  checkIns       CheckIn[]
  seats          SeatAssignment[]

  @@unique([eventId, slug])
  @@index([eventId, sortOrder])
  @@map("event_functions")
}

// ───────────────────────────── Audience ─────────────────────────────

enum GuestStatus {
  ACTIVE
  ARCHIVED
}

model Guest {
  id                String      @id @default(uuid(7)) @db.Uuid
  eventId           String      @db.Uuid
  name              String
  phone             String?
  email             String?     @db.Citext
  address           String?
  notes             String?
  guestType         String      @default("ADULT")
  /// Event-day flags for the welcome desk (spec §52).
  isVip             Boolean     @default(false)
  /// Dietary needs, e.g. "Jain" or "Vegetarian, no onion or garlic".
  dietary           String?
  status            GuestStatus @default(ACTIVE)
  preferredLanguage String?
  metadata          Json        @default("{}")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  groups       GuestGroupMember[]
  functions    FunctionGuest[]
  invitations  Invitation[]
  rsvps        RSVP[]
  checkIns     CheckIn[]
  consents     Consent[]
  registration Registration?
  seats        SeatAssignment[]
  stay         GuestStay?
  travel       GuestTravel[]

  @@index([eventId, deletedAt])
  @@index([eventId, phone])
  @@index([eventId, email])
  @@map("guests")
}

enum GuestGroupKind {
  SYSTEM
  CUSTOM
}

model GuestGroup {
  id          String         @id @default(uuid(7)) @db.Uuid
  eventId     String         @db.Uuid
  name        String
  slug        String
  description String?
  kind        GuestGroupKind @default(CUSTOM)
  color       String?
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  event     Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members   GuestGroupMember[]
  functions FunctionAudienceGroup[]

  @@unique([eventId, slug])
  @@index([eventId])
  @@map("guest_groups")
}

model GuestGroupMember {
  groupId   String   @db.Uuid
  guestId   String   @db.Uuid
  eventId   String   @db.Uuid
  createdAt DateTime @default(now())

  group GuestGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  guest Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([groupId, guestId])
  @@index([guestId])
  @@index([eventId])
  @@map("guest_group_members")
}

/// Group-based audience: every member of the group is part of the function audience.
model FunctionAudienceGroup {
  functionId String   @db.Uuid
  groupId    String   @db.Uuid
  createdAt  DateTime @default(now())

  function EventFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)
  group    GuestGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([functionId, groupId])
  @@index([groupId])
  @@map("function_audience_groups")
}

enum FunctionInvitationStatus {
  NOT_SENT
  SENT
  OPENED
}

enum RSVPStatus {
  PENDING
  ATTENDING
  DECLINED
  MAYBE
}

/// Direct guest <-> function assignment. allowed=false is an explicit deny that
/// overrides any group-based audience.
model FunctionGuest {
  functionId       String                   @db.Uuid
  guestId          String                   @db.Uuid
  eventId          String                   @db.Uuid
  invitationStatus FunctionInvitationStatus @default(NOT_SENT)
  /// Denormalized from RSVP for fast dashboards; written in the same transaction.
  rsvpStatus       RSVPStatus               @default(PENDING)
  allowed          Boolean                  @default(true)
  plusOneAllowed   Boolean                  @default(false)
  /// Maximum attendees for this guest (including the guest).
  guestLimit       Int                      @default(1)
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  function EventFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)
  guest    Guest         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([functionId, guestId])
  @@index([guestId])
  @@index([eventId, rsvpStatus])
  @@map("function_guests")
}

// ───────────────────────────── Invitations ─────────────────────────────

enum InvitationStatus {
  ACTIVE
  SENT
  OPENED
  RESPONDED
  REVOKED
  EXPIRED
}

/// An invitation to a guest. functionId null = event-wide invitation covering
/// every function the guest is authorized for; non-null = function-specific.
model Invitation {
  id          String           @id @default(uuid(7)) @db.Uuid
  eventId     String           @db.Uuid
  guestId     String           @db.Uuid
  functionId  String?          @db.Uuid
  status      InvitationStatus @default(ACTIVE)
  sentAt      DateTime?
  openedAt    DateTime?
  acceptedAt  DateTime?
  declinedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String?          @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  event      Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest      Guest                @relation(fields: [guestId], references: [id], onDelete: Cascade)
  function   EventFunction?       @relation(fields: [functionId], references: [id], onDelete: Cascade)
  tokens     InvitationToken[]
  deliveries InvitationDelivery[]
  rsvps      RSVP[]

  @@index([eventId, status])
  @@index([guestId])
  @@index([functionId])
  @@map("invitations")
}

/// Secret access token. The raw token is never stored in plaintext: tokenHash
/// (SHA-256) is used for lookup; tokenCiphertext (AES-256-GCM) lets hosts copy
/// the link again without regenerating it.
model InvitationToken {
  id              String    @id @default(uuid(7)) @db.Uuid
  invitationId    String    @db.Uuid
  eventId         String    @db.Uuid
  tokenHash       String    @unique
  tokenCiphertext String
  expiresAt       DateTime?
  revokedAt       DateTime?
  maxUses         Int?
  useCount        Int       @default(0)
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([eventId])
  @@map("invitation_tokens")
}

enum DeliveryChannel {
  WHATSAPP_LINK
  WHATSAPP_API
  SMS
  EMAIL
  PUSH
  MANUAL
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model InvitationDelivery {
  id                String          @id @default(uuid(7)) @db.Uuid
  invitationId      String          @db.Uuid
  channel           DeliveryChannel
  status            DeliveryStatus  @default(QUEUED)
  provider          String?
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime        @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("invitation_deliveries")
}

// ───────────────────────────── RSVP ─────────────────────────────

/// functionId null = event-level RSVP. Partial unique indexes (see migration SQL)
/// guarantee at most one event-level and one per-function RSVP per guest.
model RSVP {
  id            String     @id @default(uuid(7)) @db.Uuid
  eventId       String     @db.Uuid
  guestId       String     @db.Uuid
  functionId    String?    @db.Uuid
  invitationId  String?    @db.Uuid
  status        RSVPStatus
  attendeeCount Int        @default(1)
  message       String?
  source        String     @default("INVITATION")
  respondedAt   DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest      Guest          @relation(fields: [guestId], references: [id], onDelete: Cascade)
  function   EventFunction? @relation(fields: [functionId], references: [id], onDelete: Cascade)
  invitation Invitation?    @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  answers    RSVPAnswer[]

  @@index([eventId, functionId, status])
  @@index([guestId])
  @@index([functionId])
  @@map("rsvps")
}

enum RSVPQuestionType {
  TEXT
  NUMBER
  BOOLEAN
  SINGLE_CHOICE
  MULTI_CHOICE
}

model RSVPQuestion {
  id         String           @id @default(uuid(7)) @db.Uuid
  eventId    String           @db.Uuid
  /// null = asked for every function RSVP; otherwise only for this function.
  functionId String?          @db.Uuid
  key        String
  /// Label per locale: {"en":"Meal preference","hi":"भोजन वरीयता"}
  label      Json
  type       RSVPQuestionType
  /// [{"value":"veg","label":{"en":"Vegetarian"}}]
  options    Json             @default("[]")
  required   Boolean          @default(false)
  sortOrder  Int              @default(0)
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  function EventFunction? @relation(fields: [functionId], references: [id], onDelete: Cascade)
  answers  RSVPAnswer[]

  @@unique([eventId, key])
  @@map("rsvp_questions")
}

model RSVPAnswer {
  id         String   @id @default(uuid(7)) @db.Uuid
  rsvpId     String   @db.Uuid
  questionId String   @db.Uuid
  value      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

