// ───────────────────────── Templates & Assets ─────────────────────────

enum TemplateType {
  WEBSITE
  VIDEO
  DIGITAL_CARD
  EMAIL
  SOCIAL
}

enum TemplateTier {
  FREE
  STANDARD
  PREMIUM
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

model Template {
  id               String         @id @default(uuid(7)) @db.Uuid
  key              String         @unique
  name             String
  description      String?
  category         String
  style            String?
  tier             TemplateTier   @default(STANDARD)
  /**
   * Marketing badge: NEW, POPULAR, BESTSELLER.
   */
  badge            String?
  featured         Boolean        @default(false)
  sortOrder        Int            @default(0)
  eventTypes       String[]       @default([])
  languages        String[]       @default([])
  outputs          TemplateType[]
  isPremium        Boolean        @default(false)
  tags             String[]       @default([])
  status           TemplateStatus @default(DRAFT)
  thumbnailAssetId String?        @db.Uuid
  previewAssetId   String?        @db.Uuid
  currentVersionId String?        @unique @db.Uuid
  /// Soft delete: hidden everywhere (staff can restore). Events keep their pinned version,
  /// and the catalog seed never recreates a deleted template.
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  versions       TemplateVersion[] @relation("TemplateVersions")
  currentVersion TemplateVersion?  @relation("TemplateCurrentVersion", fields: [currentVersionId], references: [id])

  @@index([status, category])
  @@index([status, featured, sortOrder])
  @@index([deletedAt])
  @@map("templates")
}

model TemplateVersion {
  id          String         @id @default(uuid(7)) @db.Uuid
  templateId  String         @db.Uuid
  version     Int
  type        TemplateType
  /// Validated by @bulava/template-schema.
  definition  Json
  status      TemplateStatus @default(DRAFT)
  changelog   String?
  publishedAt DateTime?
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now())

  template   Template                 @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  currentOf  Template?                @relation("TemplateCurrentVersion")
  sections   TemplateSection[]
  assets     TemplateAsset[]
  selections EventTemplateSelection[]
  videoJobs  VideoJob[]

  @@unique([templateId, version])
  @@map("template_versions")
}

model TemplateSection {
  id                String @id @default(uuid(7)) @db.Uuid
  templateVersionId String @db.Uuid
  sectionKey        String
  sortOrder         Int
  props             Json   @default("{}")

  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)

  @@index([templateVersionId])
  @@map("template_sections")
}

model Theme {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  name      String
  tokens    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  functions EventFunction[]

  @@map("themes")
}

model EventTemplateSelection {
  id                String       @id @default(uuid(7)) @db.Uuid
  eventId           String       @db.Uuid
  output            TemplateType
  templateVersionId String       @db.Uuid
  /// Only properties the template marks as editable are accepted.
  customization     Json         @default("{}")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id])

  @@unique([eventId, output])
  @@map("event_template_selections")
}

enum AssetType {
  IMAGE
  VIDEO
  SVG
  AUDIO
  FONT
  LOTTIE
}

enum AssetStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  ARCHIVED
}

model AssetLicense {
  id                  String    @id @default(uuid(7)) @db.Uuid
  licenseType         String
  provider            String
  source              String?
  licenseDocumentKey  String?
  purchaseReference   String?
  commercialUse       Boolean
  onDemandUse         Boolean
  socialMediaUse      Boolean   @default(false)
  attributionRequired Boolean   @default(false)
  attributionText     String?
  expiresAt           DateTime?
  verifiedAt          DateTime?
  verifiedById        String?   @db.Uuid
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  assets Asset[]
  music  Music[]

  @@index([expiresAt])
  @@map("asset_licenses")
}

model Asset {
  id           String      @id @default(uuid(7)) @db.Uuid
  name         String
  type         AssetType
  category     String
  tags         String[]    @default([])
  storageKey   String      @unique
  thumbnailKey String?
  mimeType     String
  sizeBytes    BigInt
  width        Int?
  height       Int?
  /// Widths of the WebP renditions the media worker made (templates/assets/<id>-w<width>.webp).
  renditions   Int[]       @default([])
  licenseId    String?     @db.Uuid
  status       AssetStatus @default(PENDING_REVIEW)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  license   AssetLicense?   @relation(fields: [licenseId], references: [id])
  templates TemplateAsset[]

  @@index([category, status])
  @@map("assets")
}

model TemplateAsset {
  templateVersionId String @db.Uuid
  assetId           String @db.Uuid

  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  asset           Asset           @relation(fields: [assetId], references: [id])

  @@id([templateVersionId, assetId])
  @@index([assetId])
  @@map("template_assets")
}

model Music {
  id              String      @id @default(uuid(7)) @db.Uuid
  title           String
  artist          String?
  durationSeconds Int
  storageKey      String      @unique
  collection      String      @default("LICENSED")
  licenseId       String      @db.Uuid
  status          AssetStatus @default(PENDING_REVIEW)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  license AssetLicense @relation(fields: [licenseId], references: [id])

  @@map("music")
}

