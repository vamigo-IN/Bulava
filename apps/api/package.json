    "@bulava/settings": "workspace:*",
    "@bulava/storage": "workspace:*",
    "@bulava/template-schema": "workspace:*",
    "@bulava/validation": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@sentry/node": "^11.1.0",
