# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development

# ── Database / cache ──
POSTGRES_USER=bulava
POSTGRES_PASSWORD=bulava_dev_password
POSTGRES_DB=bulava
DATABASE_URL=postgresql://bulava:bulava_dev_password@127.0.0.1:5432/bulava?schema=public
TEST_DATABASE_URL=postgresql://bulava:bulava_dev_password@127.0.0.1:5432/bulava_test?schema=public
REDIS_URL=redis://127.0.0.1:6379

# ── API ──
API_PORT=4000
# json (default) or pretty (local dev only; needs the pino-pretty dev dependency)
LOG_FORMAT=pretty
# Public origin of the web app; used for invitation links and CORS.
WEB_ORIGIN=http://localhost:3000
# Additional allowed CORS origins, comma separated (e.g. the admin app).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-dev-access-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 32 bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=ZGV2LW9ubHktdG9rZW4tZW5jcnlwdGlvbi1rZXktMzI=
# Set to true behind HTTPS (production).
COOKIE_SECURE=false
# false | true (1 hop) | hop count | subnets, e.g. loopback,uniquelocal (Docker network)
TRUST_PROXY=loopback

# ── Owner account (created/promoted by `pnpm db:seed`) ──
# Becomes the Super Admin while the platform has none (there is only ever one); once the role
# has been handed over in the console (Staff & roles), seeding never takes it back.
# Leave empty to skip. ADMIN_RESET_PASSWORD=true overwrites an existing admin's password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin
ADMIN_RESET_PASSWORD=false
# Staff (every platform role except USER) must pass two-step sign-in (authenticator app) before any
# admin route. Defaults to true in production and cannot be turned off there.
# Lost device: the Super Admin resets it in Staff & roles, or pnpm admin:reset-mfa <email>.
STAFF_MFA_REQUIRED=false

# ── Integrations ──
# Payments, email, WhatsApp, Google Maps and custom domains are managed by the Super Admin in the
# admin console (Website > Integrations). The variables below are used until a group is first saved
# there; the first save copies them (secrets encrypted) and the console's values win from then on.
# Storage stays in this file only.

# ── Web ──
# Where the Next.js server reaches the API (server-side fetches and /api rewrites).
API_INTERNAL_URL=http://127.0.0.1:4000

# ── Object storage (S3 API: Cloudflare R2 in production, SeaweedFS locally) ──
R2_ENDPOINT=http://127.0.0.1:9000
# Endpoint browsers use for signed URLs (differs from R2_ENDPOINT inside Docker).
R2_PUBLIC_ENDPOINT=http://localhost:9000
R2_REGION=auto
R2_ACCESS_KEY=bulava
R2_SECRET_KEY=bulava_dev_secret
R2_BUCKET=bulava-dev
# Create the bucket on startup (development only).
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Queues / workers ──
MEDIA_WORKER_CONCURRENCY=2
VIDEO_WORKER_CONCURRENCY=1
WORKER_CONCURRENCY=10

# ── Event lifecycle (general worker, daily) ──
# ACTIVE → COMPLETED this many days after the last function; COMPLETED → ARCHIVED later.
EVENT_COMPLETE_AFTER_DAYS=2
EVENT_ARCHIVE_AFTER_DAYS=180
# Soft-deleted events (and their photos/videos) are purged permanently after this many days.
EVENT_RETENTION_DAYS=30

# ── Email (Mailpit locally: http://localhost:8025) ──
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Bulava <invites@bulava.in>"

# ── Payments (Razorpay) — milestone: payments ──
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── "Continue with Google" (docs/authentication.md#google-sign-in) ──
# OAuth client from Google Cloud Console. Redirect URI: <WEB_ORIGIN>/api/v1/auth/google/callback
# Leave both empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Custom domains (docs/custom-domains.md) ──
# Customers point a CNAME at this name (default: domains.<WEB_ORIGIN host>).
CUSTOM_DOMAIN_TARGET=
# Optional A records for apex domains that cannot use a CNAME (comma-separated IPs).
CUSTOM_DOMAIN_ADDRESSES=
# Customer-domain certificates: Cloudflare for SaaS when both are set, or the operator with
# CUSTOM_DOMAIN_TLS=manual. With neither, custom domains are shown as "coming soon".
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CUSTOM_DOMAIN_TLS=manual

# ── WhatsApp Business (Meta Cloud API) ──
# Phone number ID, business account ID and a permanent system-user token from WhatsApp Manager.
# Templates must be approved there; body variables: {{1}} guest name, {{2}} event, {{3}} the guest's
# personal invitation link. Each plan's WhatsApp allowance is set in Plans & coupons.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_INVITATION_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ── Google Maps on invitations ──
# A browser key for the Maps Embed API, restricted to your domains in Google Cloud (it is public by
# design). Maps stay off until the Super Admin switches them on in Integrations > Google Maps.
GOOGLE_MAPS_KEY=

# ── Other integrations ──
POSTHOG_KEY=
GA4_ID=
SENTRY_DSN=
OTP_PROVIDER=
OTP_API_KEY=
